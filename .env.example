# Supabase project settings — find these in your Supabase dashboard:
# Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# The publishable key is safe to expose to the browser — data access is
# enforced by Row Level Security. The secret/service-role key is intentionally
# NOT used by this app. Never add it to any NEXT_PUBLIC_* variable.
