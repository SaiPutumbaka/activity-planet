# Supabase (Project Settings > API Keys). The publishable key is safe in the browser; RLS enforces access.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Where the public site (apps/web) is served
VITE_SITE_URL=http://localhost:3000
# Map (D-038). Basemap style URLs for light and dark; OpenFreeMap needs no key. A different tile
# host must also be added to img-src in vite.config.ts.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
VITE_MAP_STYLE_URL_DARK=https://tiles.openfreemap.org/styles/dark
# true: the Map tab uses deterministic fixture data (lib/map-mock.ts) until the map RPCs ship.
VITE_MAP_MOCK=false
