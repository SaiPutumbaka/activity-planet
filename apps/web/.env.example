# Supabase (Project Settings > API Keys). The publishable key is safe in the browser; RLS enforces access.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Where the product (apps/app) is served. Unset: https://activity-planet-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3001
# Where this site itself is served; metadataBase, robots, the sitemap and absolute share and
# calendar links are built from it. Unset: VERCEL_PROJECT_PRODUCTION_URL on Vercel, else
# https://activity-planet.vercel.app (packages/core/src/config/site.ts).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Store builds (D-013). Leave unset until the apps exist: /.well-known/apple-app-site-association
# and /.well-known/assetlinks.json return 404 without them.
# Apple Developer Team ID (10 characters), e.g. ABCDE12345
APPLE_TEAM_ID=
# SHA-256 signing-certificate fingerprints, comma-separated (upload key and Play App Signing key)
ANDROID_CERT_SHA256=
# Server only (never NEXT_PUBLIC_). /api/takedown files the public intimate-image removal request
# with the service role (migration 54: submit_takedown_request is not callable with the public
# key); without it the form answers "unavailable". Project Settings > API Keys.
SUPABASE_SERVICE_ROLE_KEY=
# Optional key for the per-client HMAC of the caller's IP (5 requests a day); defaults to the
# service role key.
TAKEDOWN_CLIENT_SALT=
# Cloudflare Turnstile on the removal form. Both set: the form shows the widget and the route
# refuses a request without a valid token. Secret unset: the check is skipped.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
