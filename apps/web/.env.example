# Supabase (Project Settings > API Keys). The publishable key is safe in the browser; RLS enforces access.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Where the product (apps/app) is served
NEXT_PUBLIC_APP_URL=http://localhost:3001
# Where this site itself is served; absolute share and calendar links are built from it. On Vercel
# it may be left unset: VERCEL_PROJECT_PRODUCTION_URL is used instead.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
